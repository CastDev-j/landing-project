---
import { Picture } from "astro:assets";
import heroImage from "assets/hero.png";
import Link from "@components/ui/link.astro";
import { IoIosPricetags } from "react-icons/io";
import { FaInfo } from "react-icons/fa6";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="py-6 md:order-1 hidden md:block">
    <Picture
      src={heroImage}
      alt="Astronaut in the air"
      widths={[200, 400, 600]}
      sizes="(max-width: 800px) 100vw, 620px"
      loading="eager"
      format="avif"
    />
  </div>
  <div>
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      Lleva tu imagen al mundo digital
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      Si eres un profesional independiente, una pequeña empresa o una startup,
      necesitas una presencia digital. Con Páginas Perfectas puedes comprar un
      paquete que se ajuste a tus necesidades y llevar tu imagen al mundo
      digital.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link
        href="/contact"
        class="flex gap-2 items-center justify-center">
        <IoIosPricetags />
        Precios
      </Link>
      <Link
        size="lg"
        style="outline"
        href="/about"
        class="flex gap-2 items-center justify-center">
        <FaInfo />
        Acerca de nosotros
      </Link>
    </div>
  </div>
</main>
