---
import LinkNoRef from "./ui/linkNoRef.astro";

interface Props {
  title: string;
  description: string;
  image: string;
  link: string;
}

const { description, image, link, title } = Astro.props;
---

<div class="max-w-sm bg-white border border-slate-200 rounded-lg shadow-sm">
  <p class="block">
    <img class="rounded-t-lg" src={image} alt={title} />
  </p>
  <div class="p-5">
    <p class="block">
      <h5 class="mb-2 text-2xl font-bold tracking-tight text-slate-900">
        {title}
      </h5>
    </p>
    <p class="mb-3 font-normal text-slate-700">
      {description}
    </p>

    <div class="flex mt-8">
      <LinkNoRef href={link || "#"} block style={"outline"}>
        {"Visitar proyecto"}
      </LinkNoRef>
    </div>
  </div>
</div>
